/**
 * Get the available options for the current user.
 */
export function getOptions(step, role) {
  const flow = POLL_FLOWS[step]

  if (!flow) return []

  if (role === "tenant" && flow.tenantOptions) {
    return flow.tenantOptions
  }

  if (role === "landlord" && flow.landlordOptions) {
    return flow.landlordOptions
  }

  return flow.options || []
}

/**
 * Get the next step after a user's choice.
 */
export function getNextStep(currentStep, choice, role) {
  const flow = POLL_FLOWS[currentStep]

  if (!flow) {
    return "end"
  }

  const options = getOptions(currentStep, role)

  const selectedOption = options.find(
    (option) => option.value === choice
  )

  if (!selectedOption) {
    return "end"
  }

  return selectedOption.nextStep
}

/**
 * Check whether this is the payment stage.
 */
export function isPaymentStep(step) {
  return step === "payment"
}

/**
 * Check whether the tenant has paid.
 */
export function hasTenantPaid(tenantPaymentStatus) {
  return tenantPaymentStatus === "succeeded"
}

/**
 * Check whether the landlord has paid.
 */
export function hasLandlordPaid(landlordPaymentStatus) {
  return landlordPaymentStatus === "succeeded"
}

/**
 * Contact can ONLY be unlocked after both payments succeed.
 */
export function canUnlockContact(
  tenantPaymentStatus,
  landlordPaymentStatus
) {
  return (
    hasTenantPaid(tenantPaymentStatus) &&
    hasLandlordPaid(landlordPaymentStatus)
  )
}

/**
 * Get the payment status for the conversation.
 */
export function getPaymentState(
  tenantPaymentStatus,
  landlordPaymentStatus
) {
  const tenantPaid = hasTenantPaid(tenantPaymentStatus)
  const landlordPaid = hasLandlordPaid(landlordPaymentStatus)

  if (tenantPaid && landlordPaid) {
    return "both_paid"
  }

  if (tenantPaid && !landlordPaid) {
    return "landlord_payment_required"
  }

  if (!tenantPaid && landlordPaid) {
    return "tenant_payment_required"
  }

  return "both_payment_required"
}

/**
 * Only the server/database should ultimately decide
 * whether contact is unlocked.
 */
export function getContactUnlockState(
  tenantPaymentStatus,
  landlordPaymentStatus
) {
  if (
    canUnlockContact(
      tenantPaymentStatus,
      landlordPaymentStatus
    )
  ) {
    return "unlocked"
  }

  return "locked"
}

/**
 * Check whether the flow has ended.
 */
export function isEndStep(step) {
  return step === "end"
}

/**
 * Check whether contact has been unlocked.
 */
export function isUnlockedStep(step) {
  return step === "unlocked"
}

/**
 * Get who should respond at a particular step.
 */
export function getResponder(step) {
  const flow = POLL_FLOWS[step]

  if (!flow) return null

  return flow.responder
}