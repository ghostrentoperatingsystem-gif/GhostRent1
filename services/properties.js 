export async function uploadPropertyImages(propertyId, files) {
  const MAX_SIZE = 5 * 1024 * 1024
  const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp']
  const uploadedUrls = []

  for (const file of files) {
    try {
      if (file.size > MAX_SIZE) {
        console.warn(`File ${file.name} too large, skipping`)
        continue
      }
      if (!ALLOWED_TYPES.includes(file.type)) {
        console.warn(`File ${file.name} invalid type, skipping`)
        continue
      }

      const fileExt = file.name.split('.').pop()
      const fileName = `${propertyId}/${Date.now()}-${Math.random().toString(36).substring(7)}.${fileExt}`
      
      const { data, error } = await supabase.storage
        .from('property-images')
        .upload(fileName, file, {
          cacheControl: '3600',
          upsert: false
        })

      if (error) {
        console.error('Upload error:', error)
        continue
      }

      const { data: urlData } = supabase.storage
        .from('property-images')
        .getPublicUrl(fileName)

      uploadedUrls.push(urlData.publicUrl)
    } catch (err) {
      console.error('Upload error:', err)
    }
  }

  return uploadedUrls
}

export async function toggleSavedProperty(userId, propertyId) {
  try {
    const { data: existing } = await supabase
      .from('saved_properties')
      .select('id')
      .eq('user_id', userId)
      .eq('property_id', propertyId)
      .single()

    if (existing) {
      await supabase
        .from('saved_properties')
        .delete()
        .eq('user_id', userId)
        .eq('property_id', propertyId)
      return { saved: false }
    } else {
      await supabase
        .from('saved_properties')
        .insert([{ user_id: userId, property_id: propertyId }])
      return { saved: true }
    }
  } catch (err) {
    console.error('toggleSavedProperty error:', err)
    return { saved: false, error: err }
  }
}

export async function getSavedProperties(userId) {
  try {
    const { data, error } = await supabase
      .from('saved_properties')
      .select('property_id, properties(*)')
      .eq('user_id', userId)
    if (error) throw error
    return data?.map(item => item.properties) || []
  } catch (err) {
    console.error('getSavedProperties error:', err)
    return []
  }
}